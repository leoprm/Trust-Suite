NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/trust_lite
JWT_SECRET=change-me

# CORS for local development.
# When true and NODE_ENV is not production, browser origins are allowed flexibly.
# Do not enable this in production.
CORS_ALLOW_ALL_IN_DEV=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Production example:
# NODE_ENV=production
# CORS_ALLOW_ALL_IN_DEV=false
# CORS_ALLOWED_ORIGINS=https://trustlite.example.com,https://branchos.example.com,https://tracelite.example.com

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdmissionPolicy {
  OPEN
  INVITE_ONLY
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum AgentRole {
  SYSTEM
  EXTERNAL
}

enum AIMemberStatus {
  IDLE
  WORKING
  RATE_LIMITED
  SUSPENDED
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  SATISFIED
  CLOSED
}

enum MatchSource {
  USER
  AI
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum UserAIProvider {
  OPENAI
  DEEPSEEK
  ANTHROPIC
  CUSTOM
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EventSource {
  USER
  SYSTEM
  ADMIN
  AUTOMATION
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  password        String?
  role            UserRole  @default(USER)
  telegramUserId  BigInt?   @unique
  createdAt       DateTime  @default(now())
  memberships    TreeMember[]
  invitedMembers TreeMember[]      @relation("Inviter")
  createdNeeds   Need[]            @relation("NeedCreator")
  ideas          Idea[]
  ideaVotes      IdeaVote[]
  userAIs        UserAI[]
  loginAttempts  LoginAttempt[]    @relation("UserLoginAttempts")
  refreshTokens  RefreshToken[]
  eventLogs      EventLog[]
  createdTokens  TokenInvitacion[] @relation("TokenCreator")
  evaluatedResults Result[]
  byoApiKeys ByoApiKey[]
  chatMessages ChatMessage[]
}

model Tree {
  id              String          @id @default(uuid())
  name            String
  description     String?         @db.Text
  icono           String          @default("🌳")
  creatorId       String?
  admissionPolicy AdmissionPolicy @default(INVITE_ONLY)
  telegramChatId  String?         @unique
  createdAt       DateTime        @default(now())
  members         TreeMember[]
  agentMemberships AgentMembership[]
  needs            Need[]            @relation("TreeNeeds")
  tasks            Task[]
  eventLogs        EventLog[]
  tokens           TokenInvitacion[] @relation("TokenTree")
  ratings          Rating[]
  chatMessages     ChatMessage[]
}

model TreeMember {
  id          String         @id @default(uuid())
  userId      String
  treeId      String
  invitedById String?
  status      MemberStatus   @default(ACTIVE)
  role        MembershipRole @default(MEMBER)
  isAI        Boolean        @default(false)
  aiProfile   String?
  aiProvider  String?
  aiModel     String?
  aiStatus    AIMemberStatus @default(IDLE)
  level       Int            @default(1)
  xp          Float          @default(0)
  dailyPoints Int            @default(100)
  joinedAt    DateTime       @default(now())
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)
  assignedTasks Task[] @relation("AssignedAI")
  @@unique([userId, treeId])
}

model Agent {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?            @db.Text
  type        String             @default("HERMES")
  createdAt   DateTime           @default(now())
  memberships AgentMembership[]
  ratings     Rating[]
}

model AgentMembership {
  id        String       @id @default(uuid())
  agentId   String
  treeId    String
  status    MemberStatus @default(ACTIVE)
  role      AgentRole    @default(EXTERNAL)
  level     Int          @default(1)
  xp        Float        @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  ratings   Rating[]
  @@unique([agentId, treeId])
}

model Rating {
  id        String   @id @default(uuid())
  agentId   String
  treeId    String
  taskId    String
  role      String
  stars     Int
  createdAt DateTime @default(now())
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  membership AgentMembership @relation(fields: [agentId, treeId], references: [agentId, treeId])
  task      Task  @relation(fields: [taskId], references: [id])
  @@index([agentId, treeId])
  @@index([taskId])
}

model Need {
  id                  String     @id @default(uuid())
  treeId              String?
  creatorId           String
  title               String
  description         String     @db.Text
  importance          Int?
  dailyVotes          Int        @default(0)
  status              NeedStatus @default(OPEN)
  telegramMessageId   Int?
  createdAt           DateTime   @default(now())
  creator  User       @relation("NeedCreator", fields: [creatorId], references: [id])
  tree     Tree?      @relation("TreeNeeds", fields: [treeId], references: [id])
  needIdeas NeedIdea[]
  ideas     Idea[]
  results   Result[]
  tasks     Task[]
}

model Idea {
  id                 String   @id @default(uuid())
  content            String   @db.Text
  creatorId          String
  isGlobal           Boolean  @default(false)
  sourceTreeId       String?
  totalLikes         Int      @default(0)
  needId             String?
  telegramMessageId  Int?
  createdAt          DateTime @default(now())
  creator  User       @relation(fields: [creatorId], references: [id])
  need     Need?      @relation(fields: [needId], references: [id])
  needIdeas NeedIdea[]
  votes     IdeaVote[]
  results   Result[]
}

model NeedIdea {
  id         String      @id @default(uuid())
  needId     String
  ideaId     String
  matchedBy  MatchSource @default(AI)
  matchScore Float       @default(0)
  createdAt  DateTime    @default(now())
  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  @@unique([needId, ideaId])
}

model IdeaVote {
  id        String   @id @default(uuid())
  ideaId    String
  userId    String
  needId    String
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([ideaId, userId, needId])
}

model Result {
  id            String      @id @default(uuid())
  needId        String
  ideaId        String
  summary       String      @db.Text
  evaluation    Int?
  createdBy     MatchSource @default(AI)
  evaluatedById String?
  evaluatedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  need      Need  @relation(fields: [needId], references: [id], onDelete: Cascade)
  idea      Idea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  evaluator User? @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)
}

model Task {
  id          String   @id @default(uuid())
  treeId      String
  needId      String?
  title       String
  description String   @db.Text
  difficulty  Int?
  assignedTo  String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tree      Tree        @relation(fields: [treeId], references: [id], onDelete: Cascade)
  need      Need?       @relation(fields: [needId], references: [id], onDelete: SetNull)
  assignedAI TreeMember? @relation("AssignedAI", fields: [assignedTo], references: [id], onDelete: SetNull)
  ratings   Rating[]

  @@index([treeId])
  @@index([assignedTo])
  @@index([status])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  status               SubscriptionStatus @default(ACTIVE)
  paddleSubscriptionId String             @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  monthlyCost          Float?
  createdAt            DateTime           @default(now())
  @@index([userId])
  @@index([status])
}

model UserAI {
  id             String        @id @default(uuid())
  userId         String
  name           String
  provider       UserAIProvider
  apiKeyHash     String
  monthlySavings Float         @default(0)
  createdAt      DateTime      @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, provider])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([tokenHash])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  createdAt DateTime @default(now())
  user User @relation("UserLoginAttempts", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model TokenInvitacion {
  id        String    @id @default(uuid())
  arbolId   String
  creadorId String
  usado     Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  arbol   Tree @relation("TokenTree", fields: [arbolId], references: [id], onDelete: Cascade)
  creador User @relation("TokenCreator", fields: [creadorId], references: [id], onDelete: Cascade)
}

model ByoApiKey {
  id           String   @id @default(uuid())
  userId       String
  name         String   @default("My Key")
  provider     String
  apiKey       String   @db.Text
  costPerToken Float    @default(0)
  maxParallel  Int      @default(5)
  createdAt    DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, provider])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  treeId    String
  agentId   String?
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "chatmessage_user_fk")
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade, map: "chatmessage_tree_fk")
  @@index([userId, treeId, createdAt])
  @@index([treeId, agentId, createdAt])
}

model EventLog {
  id           String        @id @default(uuid())
  treeId       String?
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?       @db.Text
  severity     EventSeverity @default(INFO)
  source       EventSource   @default(USER)
  createdAt    DateTime      @default(now())
  tree  Tree? @relation(fields: [treeId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([treeId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

  lastUsedAt  DateTime?

  tree         Tree              @relation(fields: [treeId], references: [id], onDelete: Cascade)
  transactions FiatTransaction[]
}

model FiatTransaction {
  id                 String                 @id @default(uuid())
  treeId             String
  branchId           String?
  taskId             String?
  externalNeedId     String?
  createdById        String?
  templateId         String?
  certifiedById      String?
  solutionProposalId String?
  amount             Float
  currency           String                 @default("CLP")
  type               TransactionType
  category           TransactionCategory
  description        String?                @db.Text
  counterpartyName   String?                @db.Text
  counterpartyType   FiatCounterpartyType?
  verificationStatus FiatVerificationStatus @default(DECLARED)
  receiptEvidenceId  String?
  rejectionReason    String?                @db.Text
  certifiedAt        DateTime?
  metadataJson       Json?
  date               DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isAutomatic        Boolean                @default(false)

  tree            Tree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  externalNeed    ExternalNeed?  @relation(fields: [externalNeedId], references: [id], onDelete: SetNull)
  template        FiatTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("FiatTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  certifiedBy     User?          @relation("FiatTransactionCertifier", fields: [certifiedById], references: [id], onDelete: SetNull)
  receiptEvidence EvidenceFile?  @relation(fields: [receiptEvidenceId], references: [id], onDelete: SetNull)

  @@index([treeId])
  @@index([branchId])
  @@index([taskId])
  @@index([createdById])
  @@index([certifiedById])
  @@index([solutionProposalId])
  @@index([type])
  @@index([counterpartyType])
  @@index([verificationStatus])
  @@index([date])
}

model DifficultyVote {

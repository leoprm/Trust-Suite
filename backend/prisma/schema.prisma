generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  is_guest  Boolean  @default(false)
  is_onboarded Boolean @default(false)
  role      Role     @default(PERSON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships         TreeMember[]
  invitedMembers      TreeMember[]         @relation("Inviter")
  createdNeeds        Need[]               @relation("NeedCreator")
  needFundings        NeedFunding[]
  ideas               Idea[]
  plantillas          PlantillaArbol[]     @relation("CreadorPlantilla")
  taskVotes           TaskVote[]
  branches            Branch[]
  taskQuestions       TaskQuestion[]
  satisfactionRatings SatisfactionRating[]
  evaluators          SatisfaccionEvaluador[]
  branchMemberships   BranchMember[]
  difficultyVotes     DifficultyVote[]
  difficultyVoteLikes DifficultyVoteLike[]
  createdTokens       TokenInvitacion[]

  sharingCode String        @unique @default(uuid()) // fallback to uuid if dbgenerated fails in some environments
  profilePic  String?       // URL to uploaded profile photo
  publicProfileEnabled Boolean @default(false)
  publicShowLevels     Boolean @default(true)
  publicShowTreeSize   Boolean @default(true)
  publicShowTaskHistory Boolean @default(true)
  visibleForRecruitment Boolean @default(false) // opt-in: visible to external recruiters
  seekingWork           Boolean @default(false) // actively looking for opportunities
  contacts    UserContact[] @relation("UserContacts")
  contactOf   UserContact[] @relation("ContactOf")
  branchNeedVotes BranchNeedVote[]
  IdeaLike    IdeaLike[]
  auditorias  Auditoria[]
  promisesPledged PromiseP2P[] @relation("Sponsor")
  bonusVotes      BonusVote[]
  notifications      Notification[]
  skillMigrations    SkillMigration[]
  connectionTokens   ConnectionToken[]
  skillProposals     SkillProposal[]
  skillEndorsements  SkillEndorsement[]
  searchPasses       SearchPass[]
  sentInvitations    InterviewInvitation[] @relation("InvitationSender")
  receivedInvitations InterviewInvitation[] @relation("InvitationReceiver")
  privacySettings    PrivacySettings?
  eventLogs          EventLog[]            @relation("EventActor")
  evidenceFiles      EvidenceFile[]        @relation("EvidenceUploader")
  externalNeedsCreated ExternalNeed[]      @relation("ExternalNeedCreator")
  solutionProposalsCreated SolutionProposal[] @relation("SolutionProposalCreator")
  solutionProposalsSelected SolutionProposal[] @relation("SolutionProposalSelector")
  scopePreferencesCreated ScopePreference[] @relation("ScopePreferenceCreator")
  autosustentoBranchConfigsCreated AutosustentoBranchConfig[] @relation("AutosustentoBranchConfigCreator")
  autosustentoIdeasCreated    AutosustentoIdea[]    @relation("AutosustentoIdeaCreator")
  autosustentoIdeaSupports    AutosustentoIdeaSupport[]
  fiatTransactionsCreated     FiatTransaction[]     @relation("FiatTransactionCreator")
  fiatTransactionsCertified   FiatTransaction[]     @relation("FiatTransactionCertifier")
  berryTransactions           BerryTransaction[]
  insightSignalsCreated       InsightSignal[]       @relation("InsightSignalCreator")
  insightInternalMatches      InsightInternalMatch[]
  insightExternalApplications InsightExternalApplication[]
  insightOpeningsCreated      InsightExternalOpening[]    @relation("OpeningCreator")
  resolvedEndorsements         ExpertEndorsement[]          @relation("EndorsementResolver")
  assignedCandidates           ExternalCandidate[]          @relation("CandidateAssigner")
}

model UserContact {
  id        String   @id @default(uuid())
  userId    String
  contactId String
  createdAt DateTime @default(now())

  user    User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("ContactOf", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
}

model ConnectionToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  userId    String
  expiresAt DateTime
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum Role {
  PERSON
  ADMINISTRATOR
}

enum TreeVisibility {
  PRIVATE
  PUBLIC
}

enum JoinPolicy {
  OPEN
  INVITE_ONLY
  REQUEST
}

enum GovernanceModel {
  DICTATORSHIP
  DEMOCRACY
}

enum PowerAssignment {
  EQUAL
  HIERARCHICAL
}

enum TreeEconomyMode {
  NO_ECONOMY
  LEGACY_FIAT
  BERRIES_LATENT
  BERRIES_ACTIVE
  TRUST_FULL
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum VisibilityLevel {
  PRIVATE
  TREE_ONLY
  TRUST_NETWORK
  PUBLIC
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EventSource {
  USER
  SYSTEM
  ADMIN
  AUTOMATION
}

enum EvidenceVisibility {
  PRIVATE
  TASK_PARTICIPANTS
  TREE_ONLY
  TRUST_NETWORK
  PUBLIC_METADATA
  PUBLIC
}

enum EvidenceFileStatus {
  ACTIVE
  DELETED
  QUARANTINED
}

model PrivacySettings {
  id                         String          @id @default(uuid())
  userId                     String          @unique
  user                       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  traceProfileVisibility     VisibilityLevel @default(TREE_ONLY)
  taskHistoryVisibility      VisibilityLevel @default(PRIVATE)
  evidenceVisibility         VisibilityLevel @default(PRIVATE)
  showInTalentSearch         Boolean         @default(false)
  allowAggregatedMetrics     Boolean         @default(true)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([traceProfileVisibility])
  @@index([showInTalentSearch])
}

enum HashtagCreationPolicy {
  ADMIN_ONLY
  USERS_ONLY
  ADMIN_AND_USERS
}

enum AdmissionPolicy {
  OPEN
  INVITE_ONLY
}

enum LocationPrivacy {
  EXACTA
  SECTOR
  OCULTA
}

enum MemberStatus {
  UNVERIFIED
  VERIFIED
  BANNED
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tree {
  id                       String                @id @default(uuid())
  name                     String
  icono                    String                @default("🌳")
  description              String?               @db.Text
  inviteCode               String                @unique
  creatorId                String?
  createdAt                DateTime              @default(now())
  
  // Territorial & Geographic Discovery
  capacidades              String                @default("[]") @db.Text
  country                  String?
  city                     String?
  sector                   String?
  
  // Ubicación Exacta GPS
  latitude                 Float?
  longitude                Float?
  direccionExacta          String?
  locationPrivacy          LocationPrivacy @default(SECTOR)
  
  // Verificación Local / Fachada
  fachadaUrl               String?         @db.Text
  googlePlaceId            String?
  isLocationVerified       Boolean         @default(false)
  
  settings                 String?               @db.Text
  visibility               TreeVisibility        @default(PRIVATE)
  admissionPolicy          AdmissionPolicy       @default(INVITE_ONLY)
  allowHashtags            Boolean               @default(true)
  allowTraditionalBranches Boolean               @default(true)
  hashtagCreationPolicy    HashtagCreationPolicy @default(ADMIN_AND_USERS)
  modoCrisis               Boolean               @default(false)
  crisisSubjects           String                @default("[]") @db.Text
  crisisExpiresAt          DateTime?
  
  // Economic Engine Settings
  economyMode              TreeEconomyMode       @default(NO_ECONOMY)
  presupuestoTotal         Float                 @default(100)
  limiteSemanasEstabilidad Int                   @default(24)
  factorDesgaste           Float                 @default(0.15)
  
  // Governance Settings
  modoGobierno             String                @default("DEMOCRATICO")
  creacionRamaDirecta      Boolean               @default(false)
  creacionRamaComunitaria  Boolean               @default(true)

  // Relations
  members          TreeMember[]
  needLinks        NeedTree[]
  assetFunds       AssetFund[]
  fiatTransactions FiatTransaction[]
  fiatTemplates    FiatTemplate[]
  branches         Branch[]
  tokensInvitacion TokenInvitacion[]
  relationsInitiated TreeRelation[] @relation("TreeRelationsSource")
  relationsReceived  TreeRelation[] @relation("TreeRelationsTarget")
  alertasZonales     AlertaZonal[]
  bonusPools         BonusPool[]
  migrationsAsSource SkillMigration[] @relation("MigrationSource")
  migrationsAsTarget SkillMigration[] @relation("MigrationTarget")
  treatiesAsSource   TrustTreaty[]    @relation("TreatySource")
  treatiesAsTarget   TrustTreaty[]    @relation("TreatyTarget")
  eventLogs          EventLog[]
  evidenceFiles      EvidenceFile[]
  externalNeeds      ExternalNeed[]
  autosustentoBranchConfigs AutosustentoBranchConfig[]
  autosustentoIdeas  AutosustentoIdea[]
  sustainabilityCycles SustainabilityCycle[]
  berryConfig        BerryConfig?
  berryTransactions  BerryTransaction[]
  berryCycles        BerryMonthlyCycle[]
  insightSignals         InsightSignal[]
  externalOpenings       InsightExternalOpening[]  @relation("TreeExternalOpenings")
  expertEndorsements     ExpertEndorsement[]
  externalCandidates     ExternalCandidate[]
  skillInfluences        SkillInfluence[]

  @@index([country, city, sector])
}

model ExternalNeed {
  id             String                 @id @default(uuid())
  treeId         String
  tree           Tree                   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                  @relation("ExternalNeedCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title          String
  description    String                 @db.Text
  status         ExternalNeedStatus     @default(DRAFT)
  clientSummary  String?                @db.Text
  desiredOutcome String?                @db.Text
  constraints    String?                @db.Text
  deadline       DateTime?
  budgetMinFiat  Float?
  budgetMaxFiat  Float?
  currency       String?                @default("CLP")
  visibility     ExternalNeedVisibility @default(TREE_ONLY)
  metadataJson   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  agents          ExternalAgent[]
  scopePoints     ScopePreference[]
  solutions       SolutionProposal[]
  fiatTransactions FiatTransaction[]

  @@index([treeId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model ExternalAgent {
  id              String            @id @default(uuid())
  externalNeedId  String
  externalNeed    ExternalNeed      @relation(fields: [externalNeedId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  organization    String?
  role            ExternalAgentRole @default(CLIENT)
  notes           String?           @db.Text
  consentAccepted Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  scopePreferences ScopePreference[]

  @@index([externalNeedId])
  @@index([email])
}

model ScopePreference {
  id               String         @id @default(uuid())
  externalNeedId   String
  externalNeed     ExternalNeed   @relation(fields: [externalNeedId], references: [id], onDelete: Cascade)
  agentId          String?
  agent            ExternalAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  label            String
  labelKey         String
  score            Int
  description      String?        @db.Text
  normalizedWeight Float?
  createdById      String?
  createdBy        User?          @relation("ScopePreferenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([externalNeedId])
  @@index([agentId])
  @@index([label])
  @@index([labelKey])
  @@index([createdById])
}

model SolutionProposal {
  id                    String                 @id @default(uuid())
  externalNeedId        String
  externalNeed          ExternalNeed           @relation(fields: [externalNeedId], references: [id], onDelete: Cascade)
  createdById           String?
  createdBy             User?                  @relation("SolutionProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                 String
  description           String                 @db.Text
  status                SolutionProposalStatus @default(DRAFT)
  estimatedFiatMin      Float?
  estimatedFiatExpected Float?
  estimatedFiatMax      Float?
  currency              String?                @default("CLP")
  estimatedBerries      Int?
  estimatedDurationDays Int?
  riskLevel             RiskLevel              @default(MEDIUM)
  assumptions           String?                @db.Text
  included              String?                @db.Text
  excluded              String?                @db.Text
  deliverables          String?                @db.Text
  acceptanceCriteria    String?                @db.Text
  maintenanceNotes      String?                @db.Text
  scopeAlignmentJson    Json?
  metadataJson          Json?
  selectedAt            DateTime?
  selectedById          String?
  selectedBy            User?                  @relation("SolutionProposalSelector", fields: [selectedById], references: [id], onDelete: SetNull)
  approvedByClientAt    DateTime?
  approvedByTreeAt      DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  budgetLines           BudgetLine[]

  @@index([externalNeedId])
  @@index([createdById])
  @@index([selectedById])
  @@index([status])
  @@index([riskLevel])
}

model BudgetLine {
  id                 String         @id @default(uuid())
  solutionProposalId String
  solutionProposal   SolutionProposal @relation(fields: [solutionProposalId], references: [id], onDelete: Cascade)
  label              String
  description        String?        @db.Text
  type               BudgetLineType
  estimatedFiat      Float?
  estimatedBerries   Int?
  currency           String?        @default("CLP")
  quantity           Float?
  unit               String?
  unitCostFiat       Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([solutionProposalId])
  @@index([type])
}

enum ExternalNeedStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  SOLUTIONS_PROPOSED
  APPROVED
  REJECTED
  CONVERTED_TO_TASKS
  CANCELLED
  COMPLETED
}

enum ExternalNeedVisibility {
  PRIVATE
  TREE_ONLY
  TRUST_NETWORK
  PUBLIC_METADATA
  PUBLIC
}

enum ExternalAgentRole {
  CLIENT
  SPONSOR
  CONTACT
  APPROVER
  OBSERVER
}

enum SolutionProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED_BY_TREE
  APPROVED_BY_CLIENT
  REJECTED
  SELECTED
  ARCHIVED
  CONVERTED_TO_TASKS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BudgetLineType {
  LABOR
  MATERIALS
  INFRASTRUCTURE
  TAXES
  RESERVE
  TREE_FUND
  MAINTENANCE
  EXTERNAL_SERVICE
  OTHER
}

model EventLog {
  id           String        @id @default(uuid())
  treeId       String?
  tree         Tree?         @relation(fields: [treeId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?         @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?       @db.Text
  severity     EventSeverity @default(INFO)
  source       EventSource   @default(USER)
  createdAt    DateTime      @default(now())

  @@index([treeId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model EvidenceFile {
  id             String             @id @default(uuid())
  uploaderId     String
  uploader       User               @relation("EvidenceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  treeId         String?
  tree           Tree?              @relation(fields: [treeId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  auditId        String?
  originalName   String
  storedName     String
  storagePath    String             @db.Text
  mimeType       String
  extension      String
  sizeBytes      Int
  visibility     EvidenceVisibility @default(TASK_PARTICIPANTS)
  status         EvidenceFileStatus @default(ACTIVE)
  checksumSha256 String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  fiatTransactions     FiatTransaction[]
  insightApplications  InsightExternalApplication[]

  @@index([uploaderId])
  @@index([treeId])
  @@index([taskId])
  @@index([visibility])
  @@index([status])
}

model TreeMember {
  id               String         @id @default(uuid())
  userId           String
  treeId           String
  invitedById      String?
  weeklyNeedPoints Int            @default(100)
  bayasBalance     Float          @default(0)
  lastBerriesUpdate DateTime      @default(now())
  lastCycleKey      String?
  strikesEconomicos String        @default("[]") @db.Text
  status           MemberStatus   @default(UNVERIFIED)
  xp               Float          @default(0)
  level            Int            @default(1)
  skills           String         @default("[]") @db.Text
  goldenTickets    String         @default("{}") @db.Text  // JSON: { "#Skill": { tickets: 3, usedOnCritical: [], streakTaskIds: [] } }
  role             MembershipRole @default(MEMBER)
  joinedAt         DateTime       @default(now())
  bonoMentoriaActivo Boolean      @default(false)
  bonoMentoriaExpira DateTime?    // null = no active bonus
  avalBanHasta       DateTime?    // null = not banned from endorsing
  endorsementsGiven   ExpertEndorsement[] @relation("EndorsementsGiven")
  endorsementsReceived ExpertEndorsement[] @relation("EndorsementsReceived")

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, treeId])
}

model Need {
  id                  String     @id @default(uuid())
  creatorId           String
  title               String
  description         String     @db.Text
  totalPointsAssigned Int        @default(0)
  failedAttempts      Int        @default(0)
  createdAt           DateTime   @default(now())
  status              NeedStatus @default(ACTIVE)
  taskId              String?
  proposesHashtag     Boolean    @default(false)

  // Pipeline thresholds
  relevanceThresholdMet Boolean   @default(false)
  relevanceMetAt         DateTime?  // when threshold was first met (for timeout tracking)
  quorumMet              Boolean   @default(false)
  totalPeopleEquivalent  Int       @default(0)  // persons * concentration multiplier

  creator   User          @relation("NeedCreator", fields: [creatorId], references: [id])
  task      Task?         @relation(fields: [taskId], references: [id])
  treeLinks NeedTree[]
  fundings  NeedFunding[]
  ideas     Idea[]
}

enum NeedStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
}

model NeedTree {
  id     String @id @default(uuid())
  needId String
  treeId String

  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([needId, treeId])
}

model NeedFunding {
  id        String   @id @default(uuid())
  userId    String
  needId    String
  treeId    String? // Optional for backwards compatibility, but we should populate it going forward
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String   @id @default(uuid())
  needId      String
  creatorId   String
  title       String
  description String   @db.Text
  likesCount  Int      @default(0)
  createdAt   DateTime @default(now())

  proposedPhasesJson String? @db.Text // JSON array of BranchPhase selected by creator

  // Resource estimates (optional, filled by the idea creator)
  requiredPeople     Int?
  requiredSkills     String? @db.Text // JSON array e.g. ["design","coding"]
  estimatedMaterials String? @db.Text // free text description
  estimatedFiatCost  Float?

  need    Need       @relation(fields: [needId], references: [id], onDelete: Cascade)
  creator User       @relation(fields: [creatorId], references: [id])
  branch  Branch?
  likes   IdeaLike[]
}

model IdeaLike {
  id        String   @id @default(uuid())
  ideaId    String
  userId    String
  weight    Float    @default(1.0)  // influence × concentration multiplier
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

model Branch {
  id                String      @id @default(uuid())
  ideaId            String?     @unique
  treeId            String?
  name              String? // For hashtag branches that don't have an Idea
  type              BranchType  @default(NORMAL)
  xpPool            Float       @default(0)
  isDesire          Boolean     @default(false)
  isHashtag         Boolean     @default(false)
  bayasFund         Float       @default(0)
  
  // Consensus & Governance
  esVotable         Boolean     @default(true)
  valorSugerido     Float?
  valorOficial      Float       @default(0)

  phase             BranchPhase @default(INVESTIGATION)
  activePhasesJson  String?     @db.Text // JSON array of BranchPhase, set during Idea promotion
  currentPhaseIndex Int         @default(0)
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())

  idea             Idea?              @relation(fields: [ideaId], references: [id])
  tree             Tree?              @relation(fields: [treeId], references: [id])
  members          BranchMember[]
  tasks            Task[]
  deliverables     PhaseDeliverable[]
  fiatTransactions FiatTransaction[]
  autosustentoConfig AutosustentoBranchConfig?
  User             User?              @relation(fields: [userId], references: [id])
  userId           String?
  needVotes        BranchNeedVote[]
  sustainabilityCycles SustainabilityCycle[]

  @@index([treeId])
  @@index([type])
}

model AutosustentoBranchConfig {
  id                        String              @id @default(uuid())
  branchId                  String              @unique
  branch                    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  treeId                    String
  tree                      Tree                @relation(fields: [treeId], references: [id], onDelete: Cascade)
  businessName              String?
  productOrService          String
  targetClient              String?             @db.Text
  valueProposition          String?             @db.Text
  status                    AutosustentoStatus  @default(PROPOSED)
  viabilitySummary          String?             @db.Text
  requiredResources         String?             @db.Text
  legalRisks                String?             @db.Text
  operationalRisks          String?             @db.Text
  startupCostFiat           Float?
  expectedMonthlyIncomeFiat Float?
  expectedMonthlyCostFiat   Float?
  currency                  String?             @default("CLP")
  reviewPeriodDays          Int?                @default(90)
  nextReviewAt              DateTime?
  closureCriteria           String?             @db.Text
  metadataJson              Json?
  createdById               String?
  createdBy                 User?               @relation("AutosustentoBranchConfigCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  split                     SustainabilitySplit?

  @@index([treeId])
  @@index([status])
  @@index([createdById])
}

model SustainabilitySplit {
  id             String                   @id @default(uuid())
  configId       String                   @unique
  config         AutosustentoBranchConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  materialsPct   Float                    @default(0)
  laborPct       Float                    @default(0)
  operationsPct  Float                    @default(0)
  taxPct         Float                    @default(0)
  reservePct     Float                    @default(0)
  maintenancePct Float                    @default(0)
  treeFundPct    Float                    @default(0)
  otherPct       Float                    @default(0)
  notes          String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model BranchMember {
  id           String   @id @default(uuid())
  userId       String
  branchId     String
  joinedPhases String   @default("[]") @db.Text // JSON array of BranchPhase the user has joined
  joinedAt     DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Task {
  id          String      @id @default(uuid())
  branchId    String
  name        String      @default("Task")
  description String      @db.Text
  status      TaskStatus  @default(OPEN)
  assignedTo  String?
  creatorId   String?
  phase       BranchPhase @default(INVESTIGATION)

  evidenceUrl    String?         @db.Text
  evidenceStatus EvidenceStatus?

  // Start photo (optional "before" evidence uploaded when task is assigned)
  startPhotoUrl String? @db.Text

  // Completion details (filled when task is marked complete)
  completionComment  String?   @db.Text
  completedAt        DateTime?
  completionPhotoUrl String?   @db.Text

  // Effort Evaluation
  requiredHours  Float?
  difficulty     Float? // 1.0 to 7.0
  isAnonymous    Boolean @default(false)
  requiresVoting Boolean @default(false)
  auditada       Boolean @default(false)
  deadlineAt     DateTime? // 1.3x requiredHours after assignment

  createdAt DateTime @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tags      TaskTag[]
  votes     TaskVote[]
  questions       TaskQuestion[]
  needs           Need[]
  difficultyVotes DifficultyVote[]
  auditorias       Auditoria[]
  promises         PromiseP2P[]
  evidenceFiles    EvidenceFile[]
  fiatTransactions FiatTransaction[]
}


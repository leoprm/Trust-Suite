generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdmissionPolicy {
  OPEN
  INVITE_ONLY
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum AgentRole {
  SYSTEM
  EXTERNAL
}

enum AIMemberStatus {
  IDLE
  WORKING
  RATE_LIMITED
  SUSPENDED
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  SATISFIED
  CLOSED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  EVIDENCE_SUBMITTED
  VERIFIED
  PAID
  DISPUTED
}

enum MatchSource {
  USER
  AI
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum UserAIProvider {
  OPENAI
  DEEPSEEK
  ANTHROPIC
  CUSTOM
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EventSource {
  USER
  SYSTEM
  ADMIN
  AUTOMATION
}

enum AssignmentReason {
  EXPLORATION
  EXPLOITATION
  MANUAL
}

enum PaymentStatus {
  GRACE
  ACTIVE
  DELINQUENT
  BLOCKED
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  password        String?
  role            UserRole  @default(USER)
  isPlatformAdmin Boolean   @default(false)  // Si true, exento de cobro
  telegramUserId  BigInt?   @unique
  createdAt       DateTime  @default(now())
  skills          String?   // JSON: {'design':45,'frontend':72}
  totalXp         Int       @default(0)
  memberships    TreeMember[]
  invitedMembers TreeMember[]      @relation("Inviter")
  createdNeeds   Need[]            @relation("NeedCreator")
  ideas          Idea[]
  ideaVotes      IdeaVote[]
  userAIs        UserAI[]
  loginAttempts  LoginAttempt[]    @relation("UserLoginAttempts")
  refreshTokens  RefreshToken[]
  eventLogs      EventLog[]
  createdTokens  TokenInvitacion[] @relation("TokenCreator")
  evaluatedResults Result[]
  byoApiKeys ByoApiKey[]
  chatMessages ChatMessage[]
  tasksCreated   Task[]            @relation("TaskCreator")
  tasksAssigned  Task[]            @relation("TaskAssignee")
  disputedTasks  Task[]            @relation("TaskDisputer")
}

model Tree {
  id              String          @id @default(uuid())
  name            String
  description     String?         @db.Text
  icono           String          @default("🌳")
  creatorId       String?
  admissionPolicy AdmissionPolicy @default(INVITE_ONLY)
  telegramChatId  String?         @unique
  telegramGroupId BigInt?         @unique
  createdAt       DateTime        @default(now())
  members         TreeMember[]
  agentMemberships AgentMembership[]
  agentRoleHistory AgentRoleHistory[]
  needs            Need[]            @relation("TreeNeeds")
  tasks            Task[]
  eventLogs        EventLog[]
  tokens           TokenInvitacion[] @relation("TokenTree")
  ratings          Rating[]
  chatMessages     ChatMessage[]
  ledgerEntries    TransactionLedger[]
  disputeMessages  DisputeMessage[]
  sandbox          TreeSandbox?
}

model TreeMember {
  id          String         @id @default(uuid())
  userId      String
  treeId      String
  invitedById String?
  status      MemberStatus   @default(ACTIVE)
  role        MembershipRole @default(MEMBER)
  isAI        Boolean        @default(false)
  aiProfile   String?
  aiProvider  String?
  aiModel     String?
  aiStatus    AIMemberStatus @default(IDLE)
  level       Int            @default(1)
  xp          Float          @default(0)
  dailyPoints    Int            @default(100)
  monthlyFee     Int?
  paymentStatus  PaymentStatus  @default(GRACE)
  graceUntil     DateTime?
  lastPaymentAt  DateTime?
  paymentSplits  PaymentSplit[]
  balance        MemberBalance?
  ledgerEntries  TransactionLedger[]
  joinedAt       DateTime       @default(now())
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)
  @@unique([userId, treeId])
}

model Agent {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?            @db.Text
  type        String             @default("HERMES")
  createdAt   DateTime           @default(now())
  memberships AgentMembership[]
  ratings     Rating[]
  profile     AgentProfile?
  roleHistory AgentRoleHistory[]
}

model AgentMembership {
  id        String       @id @default(uuid())
  agentId   String
  treeId    String
  status    MemberStatus @default(ACTIVE)
  role      AgentRole    @default(EXTERNAL)
  level     Int          @default(1)
  xp        Float        @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  ratings   Rating[]
  @@unique([agentId, treeId])
}

model AgentProfile {
  agentId             String   @id
  totalRatings        Int      @default(0)
  avgStars            Float    @default(0)
  xpByRole            Json     @default("{}")
  primaryRole         String?
  secondaryRole       String?
  confidenceScore     Float    @default(0)
  lastActiveAt        DateTime?
  explorationEligible Boolean  @default(true)
  currentTreeCount    Int      @default(0)
  updatedAt           DateTime @updatedAt
  agent               Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentRoleHistory {
  id                String           @id @default(uuid())
  agentId           String
  treeId            String
  role              String
  assignedAt        DateTime         @default(now())
  releasedAt        DateTime?
  assignmentReason  AssignmentReason
  performanceScore  Float?
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tree              Tree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  @@index([agentId])
  @@index([treeId])
  @@index([agentId, treeId])
}

model Rating {
  id                     String   @id @default(uuid())
  agentId                String
  treeId                 String
  taskId                 String
  role                   String
  stars                  Int
  crossTreeContribution  Boolean  @default(true)
  createdAt              DateTime @default(now())
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  membership AgentMembership @relation(fields: [agentId, treeId], references: [agentId, treeId])
  task      Task  @relation(fields: [taskId], references: [id])
  @@index([agentId, treeId])
  @@index([taskId])
}

model Need {
  id                  String     @id @default(uuid())
  treeId              String?
  creatorId           String
  title               String
  description         String     @db.Text
  importance          Int?
  dailyVotes          Int        @default(0)
  status              NeedStatus @default(OPEN)
  telegramMessageId   Int?
  createdAt           DateTime   @default(now())
  creator  User       @relation("NeedCreator", fields: [creatorId], references: [id])
  tree     Tree?      @relation("TreeNeeds", fields: [treeId], references: [id])
  needIdeas NeedIdea[]
  ideas     Idea[]
  results         Result[]
  tasks           Task[]
  paymentSplits   PaymentSplit[]
}

model Idea {
  id                 String   @id @default(uuid())
  content            String   @db.Text
  creatorId          String
  isGlobal           Boolean  @default(false)
  sourceTreeId       String?
  totalLikes         Int      @default(0)
  needId             String?
  telegramMessageId  Int?
  createdAt          DateTime @default(now())
  creator  User       @relation(fields: [creatorId], references: [id])
  need     Need?      @relation(fields: [needId], references: [id])
  needIdeas NeedIdea[]
  votes     IdeaVote[]
  results   Result[]
}

model NeedIdea {
  id         String      @id @default(uuid())
  needId     String
  ideaId     String
  matchedBy  MatchSource @default(AI)
  matchScore Float       @default(0)
  createdAt  DateTime    @default(now())
  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  @@unique([needId, ideaId])
}

model IdeaVote {
  id        String   @id @default(uuid())
  ideaId    String
  userId    String
  needId    String
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([ideaId, userId, needId])
}

model Result {
  id                String      @id @default(uuid())
  needId            String
  ideaId            String
  summary           String      @db.Text
  evaluation        Int?
  createdBy         MatchSource @default(AI)
  evaluatedById     String?
  evaluatedAt       DateTime?
  satisfactionScore Int         @default(0)
  satisfactionCount Int         @default(0)
  judgeComment      String?     @db.Text
  judgeAnalysis     String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  need      Need  @relation(fields: [needId], references: [id], onDelete: Cascade)
  idea      Idea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  evaluator User? @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)
  satisfactionPolls SatisfactionPoll[]
}

model SatisfactionPoll {
  id        String   @id @default(uuid())
  pollId    String   @unique
  resultId  String
  chatId    String
  messageId Int
  createdAt DateTime @default(now())
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

model Task {
  id              String     @id @default(uuid())
  treeId          String
  needId          String?
  title           String
  description     String?    @db.Text
  budget          Int                    // CLP
  status          TaskStatus @default(PENDING)
  assigneeId      String?               // userId (humano o AI)
  creatorId       String                // userId que creó la task
  skills          String?               // JSON array: ["design", "frontend"]
  evidenceUrl     String?               // URL o path de archivo subido
  evidenceType    String?               // IMAGE, FILE, LINK
  complexity      String?               // "simple" | "media" | "compleja" — definido por el creador
  xpAwarded       Int?                  // XP otorgado al verificar (según complejidad)
  disputedById      String?               // userId que disputó
  disputeReason     String?
  disputeEvidenceUrl String?
  disputedAt        DateTime?
  disputeExpiresAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tree     Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
      need     Need? @relation(fields: [needId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User  @relation("TaskCreator", fields: [creatorId], references: [id])
  disputedBy User? @relation("TaskDisputer", fields: [disputedById], references: [id], onDelete: SetNull)
  ratings    Rating[]
  disputeMessages DisputeMessage[]

  @@index([treeId])
  @@index([assigneeId])
  @@index([status])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  status               SubscriptionStatus @default(ACTIVE)
  paddleSubscriptionId String             @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  monthlyCost          Float?
  createdAt            DateTime           @default(now())
  @@index([userId])
  @@index([status])
}

model UserAI {
  id             String        @id @default(uuid())
  userId         String
  name           String
  provider       UserAIProvider
  apiKeyHash     String
  monthlySavings Float         @default(0)
  createdAt      DateTime      @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, provider])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([tokenHash])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  createdAt DateTime @default(now())
  user User @relation("UserLoginAttempts", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model TokenInvitacion {
  id        String    @id @default(uuid())
  arbolId   String
  creadorId String
  usado     Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  arbol   Tree @relation("TokenTree", fields: [arbolId], references: [id], onDelete: Cascade)
  creador User @relation("TokenCreator", fields: [creadorId], references: [id], onDelete: Cascade)
}

model ByoApiKey {
  id           String   @id @default(uuid())
  userId       String
  name         String   @default("My Key")
  provider     String
  apiKey       String   @db.Text
  costPerToken Float    @default(0)
  maxParallel  Int      @default(5)
  createdAt    DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, provider])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  treeId    String
  agentId   String?
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "chatmessage_user_fk")
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade, map: "chatmessage_tree_fk")
  @@index([userId, treeId, createdAt])
  @@index([treeId, agentId, createdAt])
}

model EventLog {
  id           String        @id @default(uuid())
  treeId       String?
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?       @db.Text
  severity     EventSeverity @default(INFO)
  source       EventSource   @default(USER)
  createdAt    DateTime      @default(now())
  tree  Tree? @relation(fields: [treeId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([treeId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model PaymentSplit {
  id          String   @id @default(uuid())
  needId      String
  memberId    String   // quien recibe el split
  percentage  Float    // 0.0 a 100.0
  reason      String   // "need_creator", "task_executor"
  createdAt   DateTime @default(now())

  need   Need       @relation(fields: [needId], references: [id])
  member TreeMember @relation(fields: [memberId], references: [id])

  @@index([needId])
  @@index([memberId])
}

model MemberBalance {
  id               String   @id @default(uuid())
  memberId         String   @unique
  availableBalance Int      @default(0)  // CLP, retirable
  pendingBalance   Int      @default(0)  // CLP, en período de clearing
  stripeAccountId  String?  // Stripe Connect account ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  member TreeMember @relation(fields: [memberId], references: [id])
}

model TransactionLedger {
  id              String   @id @default(uuid())
  treeId          String
  memberId        String
  type            String   // SPLIT_CREDIT | WITHDRAWAL | PENDING_CREDIT | PENDING_CONVERTED | REVERSAL
  amount          Int      // CLP — positive = credit, negative = debit
  description     String?
  stripeReference String?  // Stripe transfer/payout ID
  metadataJson    String?  // JSON: { taskId?, needId?, reason?, ... }
  createdAt       DateTime @default(now())

  tree   Tree       @relation(fields: [treeId], references: [id])
  member TreeMember @relation(fields: [memberId], references: [id])

  @@index([treeId])
  @@index([memberId])
  @@index([treeId, createdAt])
}

// ── Telegram Dispute Voting ──────────────────────────────────────────────

enum DisputeMessageStatus {
  OPEN
  RESOLVED_ACCEPTED
  RESOLVED_REJECTED
  EXPIRED
}

enum DisputeVoteChoice {
  UP
  DOWN
}

model DisputeMessage {
  id                String               @id @default(uuid())
  taskId            String
  treeId            String
  telegramMessageId Int
  telegramGroupId   BigInt
  status            DisputeMessageStatus @default(OPEN)
  thumbsUp          Int                  @default(0)
  thumbsDown        Int                  @default(0)
  createdAt         DateTime             @default(now())
  resolvedAt        DateTime?

  task  Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tree  Tree                 @relation(fields: [treeId], references: [id], onDelete: Cascade)
  votes TelegramDisputeVote[]

  @@index([taskId])
  @@index([treeId])
  @@index([status])
  @@index([telegramMessageId, telegramGroupId])
}

model TelegramDisputeVote {
  id                String            @id @default(uuid())
  disputeMessageId  String
  telegramUserId    BigInt
  vote              DisputeVoteChoice
  createdAt         DateTime          @default(now())

  disputeMessage DisputeMessage @relation(fields: [disputeMessageId], references: [id], onDelete: Cascade)

  @@unique([disputeMessageId, telegramUserId])
}

model TreeSandbox {
  id        String   @id @default(uuid())
  treeId    String   @unique
  port      Int      @unique
  status    String   @default("IDLE") // IDLE | RUNNING | ERROR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
}

// ── Telegram Native Polls (T8: Votación anónima) ──────────────────────────

model PollMapping {
  id        String   @id @default(uuid())
  pollId    String   @unique
  needId    String
  chatId    String
  messageId Int
  createdAt DateTime @default(now())
}

// ── Platform Config & API Usage Tracking ─────────────────────────────────

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string con el valor (número, objeto, etc.)
  label     String   @default("")  // Descripción en español
  category  String   @default("")  // "api_cost", "fixed", "margin", etc.
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ApiUsage {
  id             String   @id @default(uuid())
  userId         BigInt   // telegramUserId del usuario
  treeId         String   // árbol donde se hizo la consulta
  provider       String   @default("deepseek")  // deepseek, openai, anthropic
  model          String   @default("")          // modelo específico
  tokensIn       Int      @default(0)           // prompt_tokens
  tokensOut      Int      @default(0)           // completion_tokens
  cost           Float    @default(0)           // costo en USD calculado
  messagePreview String   @default("")          // primeros 100 chars del mensaje
  isFreePeriod        Boolean @default(false)    // si el usuario está en período gratuito
  absorbedByPlatform  Float   @default(0)        // costo absorbido si en período gratis
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([treeId])
  @@index([createdAt])
}

{
  "name": "trust-lite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --mode trust-lite",
    "dev:trust": "vite --host --mode trust-lite",
    "dev:branch": "vite --host --mode branch-os",
    "dev:trace": "vite --host --mode trace-lite",
    "dev:insight": "vite --host --mode trust-insight",
    "build": "npm run build:trust",
    "build:trust": "vite build --mode trust-lite",
    "build:branch": "vite build --mode branch-os",
    "build:trace": "vite build --mode trace-lite",
    "build:insight": "vite build --mode trust-insight",
    "build:all": "npm run build:trust && npm run build:branch && npm run build:trace && npm run build:insight",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "axios": "^1.13.6",
    "framer-motion": "^12.35.2",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.17",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-i18next": "^16.5.6",
    "react-is": "^19.2.4",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}

// ── Bolsa de Valores Éticos (Bonus Pool) ──────────────────────────────────────
// Global per-tree pool of ethical bonus categories. The sum of all percentages
// always equals exactly MAX_TOTAL_BONUS (100%).

model BonusPool {
  id                      String   @id @default(uuid())
  treeId                  String
  hashtag                 String   // e.g. "%Ecológico", "%Sostenible"
  puntosImportanciaTotal  Float    @default(0) // sum of all votes (1-10)
  porcentajeActual        Float    @default(0) // calculated proportional %  (0.0 – 1.0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tree  Tree        @relation(fields: [treeId], references: [id], onDelete: Cascade)
  votes BonusVote[]

  @@unique([treeId, hashtag])
  @@index([treeId])
}

model BonusVote {
  id          String   @id @default(uuid())
  bonusPoolId String
  userId      String
  score       Int      @default(5) // 1 to 10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bonusPool BonusPool @relation(fields: [bonusPoolId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bonusPoolId, userId])
  @@index([bonusPoolId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────────────────────────────────────
enum NotificationType {
  TASK_AUDIT       // Operativa: tarea pendiente de auditoría
  BUDGET_COMPLETE  // Económica: presupuesto de rama 100%
  LEVEL_UP         // Mérito: cambio de nivel
  XP_GAIN          // Mérito: ganancia de XP
  SKILL_UNLOCK     // Mérito: arroba dorado
  AVAL_RISK        // Riesgo: candidato avalado en riesgo
  TASK_ASSIGNED    // Operativa: te asignaron tarea
  TASK_COMPLETED   // Operativa: tarea completada
  BRANCH_VOTE      // Flujo: votación de rama
  GENERAL          // General
}

enum NotificationCategory {
  URGENTE  // Auditorías, avales
  FLUJO    // Dinero, progreso ramas
  MERITO   // XP, niveles
}

model Notification {
  id         String               @id @default(uuid())
  userId     String
  type       NotificationType     @default(GENERAL)
  category   NotificationCategory @default(FLUJO)
  title      String
  body       String               @db.Text
  entityType String?              // 'arbol' | 'necesidad' | 'rama' | 'tarea'
  entityAction String?            // 'crear' | 'hacer' | 'medir'
  entityId   String?              // ID of related entity for deep-link
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Protocolo de Migración de Oficio (Skill Interoperability)
// ─────────────────────────────────────────────────────────────────────────────

enum MigrationStatus {
  EN_PRUEBA       // Foreign specialist completing 3 trial tasks
  APROBADO        // Passed — local ESPECIALISTA
  REPROBADO       // Failed — did not pass trial
}

// Individual user skill migration attempt between two trees for a specific hashtag
model SkillMigration {
  id               String          @id @default(uuid())
  userId           String
  hashtag          String          // The skill/arroba being migrated
  sourceTreeId     String          // Tree where skill was originally certified
  targetTreeId     String          // Tree where user wants to use skill
  status           MigrationStatus @default(EN_PRUEBA)
  tasksCompleted   Int             @default(0)  // 0-3 trial tasks completed successfully
  tasksFailed      Int             @default(0)  // failed trial tasks
  autoApproved     Boolean         @default(false) // true if approved via TrustTreaty
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTree Tree @relation("MigrationSource", fields: [sourceTreeId], references: [id], onDelete: Cascade)
  targetTree Tree @relation("MigrationTarget", fields: [targetTreeId], references: [id], onDelete: Cascade)

  @@unique([userId, hashtag, sourceTreeId, targetTreeId])
  @@index([targetTreeId, hashtag])
  @@index([userId, status])
}

// Trust treaty between two trees for a specific hashtag (mass-critical validation)
model TrustTreaty {
  id                    String   @id @default(uuid())
  sourceTreeId          String   // Tree sending specialists
  targetTreeId          String   // Tree receiving specialists
  hashtag               String   // Specific skill hashtag
  exitosos              Int      @default(0) // successful migrations (max counted: 7 window)
  totalIntentos         Int      @default(0) // total attempts (max 7 rolling window)
  activo                Boolean  @default(false) // true when exitosos >= 6 of 7
  revocadoPorCorrupcion Boolean  @default(false) // true if auto-revoked
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sourceTree Tree @relation("TreatySource", fields: [sourceTreeId], references: [id], onDelete: Cascade)
  targetTree Tree @relation("TreatyTarget", fields: [targetTreeId], references: [id], onDelete: Cascade)

  @@unique([sourceTreeId, targetTreeId, hashtag])
  @@index([targetTreeId, hashtag, activo])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Intra-tree skill acquisition (Genesis Phase + Maturity Phase)
// ═══════════════════════════════════════════════════════════════════════════════

enum ProposalStatus {
  PENDIENTE_AVALES  // Waiting for 3 peer endorsements (Maturity Phase)
  EN_PRUEBA         // User must complete 7 tasks diff 1-3
  APROBADO          // Passed trial → skill granted
  RECHAZADO         // Failed/rejected
}

model SkillProposal {
  id              String         @id @default(uuid())
  userId          String
  treeId          String
  hashtag         String         // e.g. "#Diseño"
  status          ProposalStatus @default(PENDIENTE_AVALES)
  tasksCompleted  Int            @default(0)  // 0-7 trial tasks completed
  tasksFailed     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  endorsements SkillEndorsement[]

  @@unique([userId, treeId, hashtag])
  @@index([treeId, hashtag, status])
}

model SkillEndorsement {
  id           String   @id @default(uuid())
  proposalId   String
  endorserId   String
  createdAt    DateTime @default(now())

  proposal SkillProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  endorser User          @relation(fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([proposalId, endorserId])
}

// ── Search Pass (30-day paid access for external recruiters) ────────────────
model SearchPass {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ── Skill-Based XP Accumulation (independent of tree level) ─────────────────
model UserSkillXP {
  id                String   @id @default(uuid())
  userId            String
  skillTag          String   // the @ / # skill name
  treeId            String
  accumulatedPoints Int      @default(0)
  completedTasks    Int      @default(0)
  cachedPercentile  Int?     // 0-100, recalculated by cron
  updatedAt         DateTime @updatedAt

  @@unique([userId, skillTag, treeId])
  @@index([skillTag, treeId, accumulatedPoints])
}

// ── Interview Invitations (Recruitment) ─────────────────────────────────────
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model InterviewInvitation {
  id          String           @id @default(uuid())
  senderId    String
  recipientId String
  message     String           @db.Text
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  sender    User @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("InvitationReceiver", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ideas de Autosustento
// Propuestas de negocio/servicio externo para financiar al Tree.
// NO usan Puntos de Necesidad, NO otorgan XP, NO crean transacciones fiat.
// "Las Ideas de Autosustento no definen prioridades vitales del Tree;
//  proponen medios para financiarlo en el mundo externo."
// ─────────────────────────────────────────────────────────────────────────────

enum AutosustentoIdeaStatus {
  PROPOSED
  GATHERING_SUPPORT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED_TO_BRANCH
  ARCHIVED
}

enum AutosustentoSupportType {
  LIKE
  WOULD_PARTICIPATE
  KNOWS_CLIENTS_OR_WOULD_BUY
}

model AutosustentoIdea {
  id                        String                 @id @default(uuid())
  treeId                    String
  tree                      Tree                   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdById               String?
  createdBy                 User?                  @relation("AutosustentoIdeaCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title                     String
  description               String                 @db.Text
  status                    AutosustentoIdeaStatus @default(PROPOSED)

  productOrService          String?
  targetClient              String?                @db.Text
  valueProposition          String?                @db.Text
  requiredResources         String?                @db.Text

  estimatedStartupCostFiat  Float?
  expectedMonthlyIncomeFiat Float?
  expectedMonthlyCostFiat   Float?
  currency                  String?                @default("CLP")

  legalRisks                String?                @db.Text
  operationalRisks          String?                @db.Text
  socialRisks               String?                @db.Text

  viabilitySummary          String?                @db.Text
  closureCriteria           String?                @db.Text
  reviewPeriodDays          Int?                   @default(90)

  convertedBranchId         String?
  convertedAt               DateTime?
  convertedById             String?

  metadataJson              Json?

  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  supports                  AutosustentoIdeaSupport[]

  @@index([treeId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model AutosustentoIdeaSupport {
  id          String                  @id @default(uuid())
  ideaId      String
  idea        AutosustentoIdea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportType AutosustentoSupportType
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([ideaId, userId, supportType])
  @@index([ideaId])
  @@index([userId])
  @@index([supportType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Excedente de Sostenibilidad — Sustainability Cycles
// Snapshot periódico del resultado financiero de una Rama de Autosustento.
// NO otorga XP, nivel, votos, autoridad ni Berries.
// "El fiat puede financiar recursos, pero no comprar autoridad."
// ─────────────────────────────────────────────────────────────────────────────

enum SustainabilityCycleStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  LOCKED
}

enum SustainabilityAllocationType {
  RESERVE
  MAINTENANCE
  TREE_FUND
  REINVESTMENT
  OTHER
}

model SustainabilityCycle {
  id                 String                   @id @default(uuid())
  treeId             String
  tree               Tree                     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  periodStart        DateTime
  periodEnd          DateTime
  currency           String                   @default("CLP")

  // Aggregated from FiatTransactions
  totalIncomeFiat    Float                    @default(0)
  totalExpenseFiat   Float                    @default(0)
  totalInvestmentFiat Float                   @default(0)
  netFiat            Float                    @default(0)
  surplusFiat        Float                    @default(0)
  deficitFiat        Float                    @default(0)
  marginPct          Float                    @default(0)

  // Expense breakdown by category (mapped from TransactionCategory)
  materialsFiat      Float                    @default(0)
  laborFiat          Float                    @default(0)
  operationsFiat     Float                    @default(0)
  taxFiat            Float                    @default(0)
  reserveFiat        Float                    @default(0)
  maintenanceFiat    Float                    @default(0)
  reinvestmentFiat   Float                    @default(0)
  otherFiat          Float                    @default(0)

  // Suggested allocation from surplus (based on SustainabilitySplit)
  treeFundFiat       Float                    @default(0)

  // Verification quality
  transactionsCount  Int                      @default(0)
  verifiedAmountFiat Float                    @default(0)
  includeOnlyVerified Boolean                 @default(false)
  multiCurrencyWarning Boolean                @default(false)

  status             SustainabilityCycleStatus @default(DRAFT)
  calculatedAt       DateTime?
  approvedAt         DateTime?
  approvedById       String?
  lockedAt           DateTime?
  lockedById         String?

  notes              String?                  @db.Text
  metadataJson       Json?

  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  allocations        SustainabilityAllocation[]

  @@index([treeId])
  @@index([branchId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}

model SustainabilityAllocation {
  id          String                       @id @default(uuid())
  cycleId     String
  cycle       SustainabilityCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  type        SustainabilityAllocationType
  amountFiat  Float
  currency    String                       @default("CLP")
  notes       String?                      @db.Text
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([cycleId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Berries — circulación interna del Tree
// El fiat no compra Berries. Las Berries no compran XP, votos ni autoridad.
// Reducción mensual: 10% sobre saldo al inicio del ciclo. El 10% se destruye.
// ─────────────────────────────────────────────────────────────────────────────

enum BerryTransactionType {
  TASK_REWARD
  AUDIT_REWARD
  LEVEL_REWARD
  P2P_TRANSFER_IN
  P2P_TRANSFER_OUT
  MONTHLY_FLOW_LOSS
  ADJUSTMENT
  REVERSAL
}

enum BerryCycleStatus {
  RUNNING
  COMPLETED
  FAILED
}

model BerryConfig {
  id                  String   @id @default(uuid())
  treeId              String   @unique
  tree                Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  berriesEnabled      Boolean  @default(false)
  monthlyFlowRate     Float    @default(0.10)
  monthlyFlowDay      Int      @default(1)
  allowP2PTransfers   Boolean  @default(false)
  allowTaskRewards    Boolean  @default(true)
  allowAuditRewards   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([treeId])
}

model BerryTransaction {
  id            String               @id @default(uuid())
  treeId        String
  tree          Tree                 @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromUserId    String?
  toUserId      String?
  type          BerryTransactionType
  amount        Float
  balanceBefore Float?
  balanceAfter  Float?
  cycleKey      String?
  sourceType    String?
  sourceId      String?
  description   String?              @db.Text
  metadataJson  Json?
  createdAt     DateTime             @default(now())

  @@index([treeId])
  @@index([userId])
  @@index([type])
  @@index([cycleKey])
  @@index([createdAt])
}

model BerryMonthlyCycle {
  id             String           @id @default(uuid())
  treeId         String
  tree           Tree             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  cycleKey       String
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  status         BerryCycleStatus @default(RUNNING)
  usersProcessed Int              @default(0)
  totalDestroyed Float            @default(0)
  metadataJson   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([treeId, cycleKey])
  @@index([treeId])
  @@index([cycleKey])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust Insight
// Escalamiento de necesidades persistentes no resueltas.
// "Primero resolver internamente; luego atraer personas externas;
//  solo finalmente derivar a empresas externas."
// NO otorga XP. NO crea pagos fiat. NO emite Berries.
// NO expone datos personales.
// ─────────────────────────────────────────────────────────────────────────────

enum InsightSourceType {
  INTERNAL_NEED
  EXTERNAL_NEED
  BRANCH
  SOLUTION_PROPOSAL
  TASK_PATTERN
  MANUAL
}

enum InsightSignalStatus {
  DRAFT
  ACTIVE
  INTERNAL_SEARCH
  INTERNAL_SOLUTION_FOUND
  EXTERNAL_PEOPLE_OPEN
  EXTERNAL_PEOPLE_IN_REVIEW
  EXTERNAL_PEOPLE_FAILED
  CORPORATE_REFERRAL_OPEN
  CORPORATE_REFERRAL_SELECTED
  RESOLVED
  CANCELLED
  ARCHIVED
}

enum InsightEscalationLevel {
  INTERNAL_TRUST
  EXTERNAL_PEOPLE
  EXTERNAL_COMPANY
}

enum InsightVisibility {
  PRIVATE
  TREE_ONLY
  TRUST_NETWORK
  PUBLIC_METADATA
  PUBLIC_OPENING
}

enum InternalMatchType {
  USER
  BRANCH
  TREE
  AUTOSUSTENTO_BRANCH
  PREVIOUS_TASK
  SOLUTION
}

enum InternalMatchStatus {
  SUGGESTED
  CONTACTED
  ACCEPTED
  DECLINED
  INSUFFICIENT_CAPACITY
  SELECTED
}

enum ExternalOpeningStatus {
  DRAFT
  INTERNAL_REVIEW
  OPEN
  PAUSED
  CLOSED
  ENOUGH_CANDIDATES
  NOT_ENOUGH_CANDIDATES
  CANCELLED
  CONVERTED_TO_VALIDATION
  ARCHIVED
}

enum ExternalApplicationStatus {
  RECEIVED
  BASIC_REVIEW
  MORE_INFO_REQUESTED
  INVITED_TO_VALIDATION
  REJECTED
  WITHDRAWN
  ACCEPTED_FOR_NEXT_STEP
  CONVERTED_TO_USER
  ARCHIVED
}

enum ExternalWorkMode {
  REMOTE_ONLY
  ON_SITE_ONLY
  HYBRID
  REMOTE_ALLOWED
}

enum ExternalPaymentMode {
  FIAT
  BERRIES
  MIXED
  UNPAID_VOLUNTEER
}

enum OpeningUrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpeningRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExternalOpeningVisibility {
  PRIVATE
  TREE_ONLY
  TRUST_NETWORK
  PUBLIC_METADATA
  PUBLIC_APPLICATION
}

enum CorporateReferralStatus {
  DRAFT
  OPEN
  CONTACTED
  PROPOSAL_RECEIVED
  SELECTED
  REJECTED
  CANCELLED
}

model InsightSignal {
  id                   String                 @id @default(uuid())

  treeId               String
  tree                 Tree                   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  sourceType           InsightSourceType      @default(MANUAL)
  // String refs to source records — no formal FK to avoid coupling existing models
  sourceNeedId         String?
  sourceExternalNeedId String?
  sourceBranchId       String?
  sourceSolutionId     String?

  createdById          String?
  createdBy            User?                  @relation("InsightSignalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title                String
  description          String                 @db.Text

  status               InsightSignalStatus    @default(DRAFT)
  escalationLevel      InsightEscalationLevel @default(INTERNAL_TRUST)
  visibility           InsightVisibility      @default(TREE_ONLY)

  persistenceScore     Float?
  capacityGapScore     Float?
  urgencyScore         Float?
  strategicValueScore  Float?

  requiredSkillTags    Json?
  requiredResources    String?                @db.Text
  locationText         String?
  remoteAllowed        Boolean                @default(true)

  budgetFiatMin        Float?
  budgetFiatExpected   Float?
  budgetFiatMax        Float?
  currency             String?                @default("CLP")

  estimatedBerries     Int?

  internalSearchStartedAt  DateTime?
  internalSearchEndedAt    DateTime?
  externalPeopleOpenedAt   DateTime?
  externalPeopleClosedAt   DateTime?
  corporateOpenedAt        DateTime?
  corporateClosedAt        DateTime?

  resolutionNotes      String?                @db.Text
  metadataJson         Json?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  internalMatches      InsightInternalMatch[]
  externalOpenings     InsightExternalOpening[]
  corporateReferrals   InsightCorporateReferral[]

  @@index([treeId])
  @@index([status])
  @@index([escalationLevel])
  @@index([sourceType])
  @@index([createdAt])
}

model InsightInternalMatch {
  id                String              @id @default(uuid())

  insightSignalId   String
  insightSignal     InsightSignal       @relation(fields: [insightSignalId], references: [id], onDelete: Cascade)

  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  branchId          String?
  treeId            String?

  matchType         InternalMatchType
  matchScore        Float?

  skillTags         Json?
  evidenceSummary   String?             @db.Text
  availabilityNote  String?             @db.Text

  status            InternalMatchStatus @default(SUGGESTED)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([insightSignalId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
}

model InsightExternalOpening {
  id                     String                     @id @default(uuid())

  insightSignalId        String
  insightSignal          InsightSignal              @relation(fields: [insightSignalId], references: [id], onDelete: Cascade)

  treeId                 String?
  tree                   Tree?                      @relation("TreeExternalOpenings", fields: [treeId], references: [id], onDelete: Cascade)

  createdById            String?
  createdBy              User?                      @relation("OpeningCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title                  String
  summary                String?                    @db.Text
  description            String                     @db.Text

  status                 ExternalOpeningStatus      @default(DRAFT)

  requiredSkillTags      Json?
  adjacentSkillTags      Json?
  desiredExperience      String?                    @db.Text
  desiredEvidence        String?                    @db.Text
  practicalTestNote      String?                    @db.Text

  workMode               ExternalWorkMode           @default(REMOTE_ALLOWED)
  remoteAllowed          Boolean                    @default(true)
  locationText           String?

  paymentMode            ExternalPaymentMode        @default(FIAT)
  paymentFiatMin         Float?
  paymentFiatExpected    Float?
  paymentFiatMax         Float?
  currency               String?                    @default("CLP")
  paymentBerries         Int?
  paymentBerriesMin      Int?
  paymentBerriesExpected Int?
  paymentBerriesMax      Int?

  estimatedDurationDays  Int?
  estimatedHours         Int?

  urgencyLevel           OpeningUrgencyLevel        @default(MEDIUM)
  riskLevel              OpeningRiskLevel           @default(MEDIUM)

  applicationDeadline    DateTime?
  maxCandidates          Int?
  minCandidatesNeeded    Int?                       @default(1)

  publicVisibility       ExternalOpeningVisibility  @default(TRUST_NETWORK)
  externalShareToken     String?                    @unique

  openedAt               DateTime?
  closedAt               DateTime?
  cancelledAt            DateTime?

  metadataJson           Json?

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  applications           InsightExternalApplication[]

  @@index([insightSignalId])
  @@index([treeId])
  @@index([status])
  @@index([createdById])
  @@index([openedAt])
  @@index([applicationDeadline])
}

model InsightExternalApplication {
  id                    String                    @id @default(uuid())

  openingId             String
  opening               InsightExternalOpening    @relation(fields: [openingId], references: [id], onDelete: Cascade)

  insightSignalId       String?
  treeId                String?

  applicantName         String
  applicantEmail        String?
  applicantPhone        String?
  applicantLocation     String?

  applicantSummary      String?                   @db.Text
  motivation            String?                   @db.Text
  experienceSummary     String?                   @db.Text

  portfolioUrl          String?
  externalProfileUrl    String?
  evidenceNote          String?                   @db.Text
  skillTags             Json?

  requestedFiat         Float?
  requestedBerries      Int?
  currency              String?                   @default("CLP")

  availabilityNote      String?
  earliestStartDate     DateTime?

  status                ExternalApplicationStatus @default(RECEIVED)

  privacyConsent        Boolean                   @default(false)
  termsAccepted         Boolean                   @default(false)

  linkedUserId          String?
  linkedUser            User?                     @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  evidenceFileId        String?
  evidenceFile          EvidenceFile?             @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)

  reviewedById          String?
  reviewedAt            DateTime?
  reviewNotes           String?                   @db.Text

  invitedToValidationAt DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?                   @db.Text

  metadataJson          Json?

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([openingId])
  @@index([insightSignalId])
  @@index([treeId])
  @@index([status])
  @@index([linkedUserId])
  @@index([applicantEmail])
  @@index([createdAt])
}

model InsightCorporateReferral {
  id                  String                  @id @default(uuid())

  insightSignalId     String
  insightSignal       InsightSignal           @relation(fields: [insightSignalId], references: [id], onDelete: Cascade)

  providerName        String
  providerContact     String?
  providerWebsite     String?

  status              CorporateReferralStatus @default(DRAFT)

  reasonForEscalation String?                 @db.Text
  expectedScope       String?                 @db.Text

  estimatedFiatMin    Float?
  estimatedFiatMax    Float?
  currency            String?                 @default("CLP")

  selectedAt          DateTime?
  notes               String?                 @db.Text
  metadataJson        Json?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([insightSignalId])
  @@index([status])
}

// ── Expert Endorsement ───────────────────────────────────────────────────────

enum ExpertEndorsementStatus {
  ACTIVE
  SUCCESS
  FAILED_PERFORMANCE
  FAILED_FRAUD
}

model ExpertEndorsement {
  id                   String                   @id @default(uuid())
  treeId               String
  tree                 Tree                     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  endorserId           String
  endorser             TreeMember               @relation("EndorsementsGiven", fields: [endorserId], references: [id], onDelete: Cascade)
  endorsedId           String
  endorsed             TreeMember               @relation("EndorsementsReceived", fields: [endorsedId], references: [id], onDelete: Cascade)
  expertise            String
  status               ExpertEndorsementStatus  @default(ACTIVE)
  requiredTasks        Int                      @default(3)
  completedTasks       Int                      @default(0)
  satisfactionThreshold Float                   @default(80)
  avgSatisfaction      Float?
  boostApplied         Boolean                  @default(true)
  evidenceTaskIds      String                   @default("[]") @db.Text
  createdAt            DateTime                 @default(now())
  resolvedAt           DateTime?
  resolvedById         String?
  resolvedBy           User?                    @relation("EndorsementResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote       String?                  @db.Text

  @@index([endorserId, endorsedId, treeId, expertise])
  @@index([treeId, endorserId, status])
  @@index([treeId, endorsedId, status])
  @@index([treeId, expertise, status])
}

// ── External Candidate Validation ─────────────────────────────────────────

enum ExternalCandidateStatus {
  APPLIED
  UNDER_REVIEW
  EVALUATORS_ASSIGNED
  PROVISIONAL
  IN_PRACTICAL_TEST
  VALIDATED
  REJECTED
}

model ExternalCandidate {
  id             String                    @id @default(uuid())
  treeId         String
  tree           Tree                      @relation(fields: [treeId], references: [id], onDelete: Cascade)

  name           String
  email          String?
  skills         String                    @db.Text
  experience     String?                   @db.Text
  portfolioUrl   String?

  status         ExternalCandidateStatus   @default(APPLIED)
  reviewerNotes  String?                   @db.Text

  evaluatorIds   String                    @default("[]") @db.Text
  evaluatorMode  String?                   // "exact" | "similar" | "adjacent" | "fallback"
  evaluatorVotes String                    @default("[]") @db.Text  // [{evaluatorId, passed, notes, submittedAt}]

  testDesign     String?                   @db.Text
  testResult     String?                   @db.Text
  testPassed     Boolean?

  entryTaskId    String?
  entryBranchId  String?

  auditLevel     Int                       @default(80)

  appliedAt      DateTime                  @default(now())
  reviewedAt     DateTime?
  provisionalAt  DateTime?
  validatedAt    DateTime?
  rejectedAt     DateTime?
  rejectionReason String?                  @db.Text

  assignedById   String?
  assignedBy     User?                     @relation("CandidateAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([treeId, status])
  @@index([status])
}

// ── Skill Influence (expert weight for idea voting) ──────────────────────

model SkillInfluence {
  id                  String   @id @default(uuid())
  treeId              String
  skillTag            String
  greenAvgDifficulty  Float    @default(0)
  goldenAvgDifficulty Float    @default(0)
  greenInfluence      Float    @default(20)   // 20–80%
  goldenInfluence     Float    @default(20)   // 20–80%
  finalInfluence      Float    @default(20)   // 0.6*green + 0.4*golden
  calculatedAt        DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([treeId, skillTag])
  @@index([skillTag])
  @@index([calculatedAt])
}
